{
  "openapi": "3.0.0",
  "info": {
    "title": "Secure Identity API Documentation",
    "description": "Comprehensive interactive API document mapping all core and bonus backend routes for the Laravel Sanctum authentication system.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000/api",
      "description": "Local Development API Server"
    }
  ],
  "paths": {
    "/register": {
      "post": {
        "summary": "Register a new user",
        "description": "Validates registration parameters and returns a personal access token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password", "password_confirmation"],
                "properties": {
                  "name": { "type": "string", "example": "Santhosh Kumar" },
                  "email": { "type": "string", "format": "email", "example": "santhosh@example.com" },
                  "password": { "type": "string", "format": "password", "example": "password123" },
                  "password_confirmation": { "type": "string", "format": "password", "example": "password123" },
                  "role": { "type": "string", "enum": ["user", "admin"], "default": "user", "example": "admin" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthSuccessResponse" }
              }
            }
          },
          "422": { "description": "Validation failed" }
        }
      }
    },
    "/login": {
      "post": {
        "summary": "Authenticate user",
        "description": "Authenticates credentials and returns a Bearer access token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "santhosh@example.com" },
                  "password": { "type": "string", "format": "password", "example": "password123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthSuccessResponse" }
              }
            }
          },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/social-login": {
      "post": {
        "summary": "Authenticate or register via OAuth Mock",
        "description": "Mock OAuth portal that creates standard accounts and returns access tokens.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "name", "provider", "provider_id"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "google.user@example.com" },
                  "name": { "type": "string", "example": "Google Explorer" },
                  "provider": { "type": "string", "enum": ["google", "github"], "example": "google" },
                  "provider_id": { "type": "string", "example": "g_123456789" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Social auth successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthSuccessResponse" }
              }
            }
          }
        }
      }
    },
    "/logout": {
      "post": {
        "summary": "Revoke active token",
        "description": "Revokes the Bearer token associated with the active request session.",
        "security": [{ "SanctumAuth": [] }],
        "responses": {
          "200": { "description": "Successfully logged out" },
          "401": { "description": "Unauthenticated" }
        }
      }
    },
    "/refresh": {
      "post": {
        "summary": "Rotate Bearer Token",
        "description": "Revokes the active Bearer token and issues a fresh rotated token.",
        "security": [{ "SanctumAuth": [] }],
        "responses": {
          "200": {
            "description": "Token rotated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthSuccessResponse" }
              }
            }
          },
          "401": { "description": "Unauthenticated" }
        }
      }
    },
    "/forgot-password": {
      "post": {
        "summary": "Request Password Reset Link",
        "description": "Registers a password reset token and logs the reset link inside backend logs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "santhosh@example.com" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Reset token generated and logged successfully" }
        }
      }
    },
    "/reset-password": {
      "post": {
        "summary": "Perform Account Password Reset",
        "description": "Validates the reset token and updates the user's password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token", "email", "password", "password_confirmation"],
                "properties": {
                  "token": { "type": "string", "example": "d2f8b5f3a09e..." },
                  "email": { "type": "string", "format": "email", "example": "santhosh@example.com" },
                  "password": { "type": "string", "format": "password", "example": "newpassword123" },
                  "password_confirmation": { "type": "string", "format": "password", "example": "newpassword123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Password updated successfully" },
          "422": { "description": "Validation failed" }
        }
      }
    },
    "/user": {
      "get": {
        "summary": "Fetch Active Profile Details",
        "description": "Returns current logged in user information.",
        "security": [{ "SanctumAuth": [] }],
        "responses": {
          "200": {
            "description": "Profile details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthenticated" }
        }
      }
    },
    "/admin/stats": {
      "get": {
        "summary": "Fetch Administrative Logs & MySQL Stats (Role-Protected)",
        "description": "Restricted endpoint allowing Admins to fetch database statistics.",
        "security": [{ "SanctumAuth": [] }],
        "responses": {
          "200": {
            "description": "Administrative metrics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Administrative statistics fetched successfully" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "total_users": { "type": "integer", "example": 3 },
                        "active_sessions": { "type": "integer", "example": 2 },
                        "system_status": { "type": "string", "example": "HEALTHY" },
                        "laravel_version": { "type": "string", "example": "11.5.0" },
                        "server_time": { "type": "string", "format": "date-time", "example": "2026-05-22T12:00:00Z" }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": { "description": "Access Denied. Admin permissions required." },
          "401": { "description": "Unauthenticated" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SanctumAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter the Sanctum Bearer token value issued after sign in or registration."
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Santhosh Kumar" },
          "email": { "type": "string", "format": "email", "example": "santhosh@example.com" },
          "role": { "type": "string", "example": "admin" },
          "created_at": { "type": "string", "format": "date-time", "example": "2026-05-22T11:26:00Z" }
        }
      },
      "AuthSuccessResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "Authentication successful" },
          "data": {
            "type": "object",
            "properties": {
              "user": { "$ref": "#/components/schemas/User" },
              "access_token": { "type": "string", "example": "1|sv0EuMxn7bc..." },
              "token_type": { "type": "string", "example": "Bearer" }
            }
          }
        }
      }
    }
  }
}
